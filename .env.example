# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Password for /lab (phase A)
LAB_PASSWORD=
# Supabase (EU region): server only, never in the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Web push (weekly colour tip). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nyansekulort@gmail.com
# Vercel Cron sends this as a bearer token; any long random string
CRON_SECRET=
# PostHog EU (public project key, phc_…; never the phs_/phx_ secret keys)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Brevo SMTP (transactional mail: order notice to the founder, guide link to the buyer)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
MAIL_FROM=KULØRT · NYANSE <hi@kulort-nyanse.com>
MAIL_TO_FOUNDER=nyansekulort@gmail.com
# Mollie (iDEAL | Wero, Apple Pay, card). test_… for testing, live_… to go live. Empty = bank transfer.
MOLLIE_API_KEY=
# Inner-circle discount codes, reusable: CODE:PERCENT, comma-separated (e.g. FAMILIE-K7Q2:100,VRIENDEN-P3X9:25)
DISCOUNT_CODES=
# Instagram autopost (docs/marketing/AUTOPOST.md): long-lived token and the Instagram business account id
IG_ACCESS_TOKEN=
IG_USER_ID=
SOCIAL_START=2026-10-26
# IG_ACCESS_TOKEN may also be an Instagram-login token (starts with IG…); IG_USER_ID is then optional

# YouTube Shorts (docs/marketing/YOUTUBE.md): OAuth client from Google Cloud; the refresh token comes from node scripts/youtube-auth.mjs
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
